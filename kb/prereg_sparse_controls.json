 {
  "claim_id": "C-002",
  "statement": "Weights that SGD finds on Picbreeder wiring do not reproduce the symmetry Picbreeder weights achieve on neurons whose parity the wiring leaves free.",
  "scope": "128x128 image regression on the three Picbreeder CPPNs, 50k iterations, Adam with unit-norm gradients, fit = MSE < 0.01. Perturbations act on existing edges only; matched window of mean |dRGB| in [0.02, 0.10]. Wiring facts known before registration: the Picbreeder masks force the parity of 82%/59%/38% of distinct maps (skull/butterfly/apple), for any weights. Skull is excluded: its Picbreeder network has only 3 free maps.",
  "group": "G1b",
  "prediction": "For M1x, r = (G1b - PB) / (G0 - PB) is at least 0.7 on butterfly and apple. r <= 0.3 falsifies: the wiring would then be sufficient. Between them is MIXED.",
  "flip_boundary": "Low redundancy on a sparse network may push SGD toward reuse, which would lower r.",
  "checks": [
   {
    "check_id": "c002_m1x_butterfly",
    "type": "position",
    "metric": "M1x",
    "where": {
     "task": "butterfly"
    },
    "low_group": "PB",
    "high_group": "G0",
    "test_group": "G1b",
    "min_n": 2,
    "pass": {
     "op": ">=",
     "value": 0.7
    },
    "fail": {
     "op": "<=",
     "value": 0.3
    }
   },
   {
    "check_id": "c002_m1x_apple",
    "type": "position",
    "metric": "M1x",
    "where": {
     "task": "apple"
    },
    "low_group": "PB",
    "high_group": "G0",
    "test_group": "G1b",
    "min_n": 2,
    "pass": {
     "op": ">=",
     "value": 0.7
    },
    "fail": {
     "op": "<=",
     "value": 0.3
    }
   }
  ],
  "parents": []
 },
