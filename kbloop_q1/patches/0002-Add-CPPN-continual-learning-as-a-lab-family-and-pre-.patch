+++ b/src/aiq_kb/kb_cppn.py
@@ -0,0 +1,203 @@
+#!/usr/bin/env python3
+"""The cppn_continual lab family: fitted dense CPPNs learning local edits in sequence, under a replay budget.
+
+kb_lab.run_job sends a job here when its dataset is cppn_continual/<task>, so the run_experiment tool can vary
+loss.replay_fraction, optimizer.lr_scale and budget.training_steps like any other lab override. Training runs in
+cppn_gpu/continual_seq.py under AIQ_CPPN_PYTHON, which may be a Windows interpreter when this code runs in WSL. Lower `mean`
+is better, as in the rest of the lab. Assets live outside the repository in AIQ_CPPN_ASSETS: genomes/<task>.zip and
+nets/<batch>/sgd_<task>.pt.
+
+  python -m aiq_kb.kb_cppn run LAB_DIR         run the registered replay budgets on every task through kb_lab.run_job
+  python -m aiq_kb.kb_cppn lab LAB_DIR         write lab_db.jsonl, allowed_datasets.txt and the check table from saved results
+  python -m aiq_kb.kb_cppn settle SEED TABLE   replay a seed KB's checks on a check table, without changing either
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+
+if __package__:
+    from .kb_checks import load_rows, normalize_checks, run_check, verdict
+else:
+    from kb_checks import load_rows, normalize_checks, run_check, verdict
+
+FAMILY = "cppn_continual"
+TASKS = ("skull", "butterfly", "apple")
+REPLAY_FRACTIONS = (0.0, 0.05, 0.2, 1.0)
+MAX_STEPS = 5000
+RUNNER = Path(__file__).resolve().parent / "cppn_gpu" / "continual_seq.py"
+RESOLUTION_PIXELS = 4096
+
+
+def _native(path: Path, python: str) -> str:
+    """A path this interpreter can open: Windows interpreters started from WSL need a Windows path."""
+    if python.lower().endswith(".exe") and shutil.which("wslpath"):
+        return subprocess.check_output(["wslpath", "-w", str(path)], text=True).strip()
+    return str(path)
+
+
+def validate(candidate: dict) -> dict:
+    """Returns the runner spec for a candidate, or raises ValueError."""
+    if set(candidate) - {"model", "optimizer", "loss", "budget"}:
+        raise ValueError("unsupported candidate control")
+    model, optimizer, loss, budget = (candidate.get(k) or {} for k in ("model", "optimizer", "loss", "budget"))
+    if model.get("type") != "cppn_dense" or model.get("group") != "G0":
+        raise ValueError("model must be the fitted dense group: type cppn_dense, group G0")
+    if optimizer.get("type") != "Adam":
+        raise ValueError("optimizer.type must be Adam")
+    if loss.get("loss_id") != "mse_balanced":
+        raise ValueError("loss.loss_id must be mse_balanced")
+    fraction, scale, steps = loss.get("replay_fraction"), optimizer.get("lr_scale"), budget.get("training_steps")
+    if isinstance(fraction, bool) or not isinstance(fraction, (int, float)) or not 0 <= fraction <= 1:
+        raise ValueError("loss.replay_fraction must be between 0 and 1")
+    if isinstance(scale, bool) or not isinstance(scale, (int, float)) or not 0 < scale <= 10:
+        raise ValueError("optimizer.lr_scale must be above 0 and at most 10")
+    if isinstance(steps, bool) or not isinstance(steps, int) or not 1 <= steps <= MAX_STEPS:
+        raise ValueError(f"budget.training_steps must be an integer from 1 to {MAX_STEPS}")
+    return {"replay_fraction": float(fraction), "lr_scale": float(scale), "steps": steps}
+
+
+def candidate(fraction: float, lr_scale: float = 1.0, steps: int = 500) -> dict:
+    return {"model": {"type": "cppn_dense", "group": "G0"}, "optimizer": {"type": "Adam", "lr_scale": lr_scale},
+            "loss": {"loss_id": "mse_balanced", "replay_fraction": fraction},
+            "budget": {"training_steps": steps, "batch_size": RESOLUTION_PIXELS}}
+
+
+def _evidence(path: Path) -> dict:
+    content = path.read_bytes()
+    return {"path": str(path), "sha256": hashlib.sha256(content).hexdigest(), "bytes": len(content)}
+
+
+def run_candidate(task: str, cand: dict, lab: Path) -> dict:
+    spec = {"task": task, **validate(cand)}
+    script = Path(os.environ.get("AIQ_CPPN_RUNNER", RUNNER))
+    key = hashlib.sha1(json.dumps({"runner": script.read_bytes().hex(), **spec}, sort_keys=True).encode()).hexdigest()[:10]
+    directory = lab / "experiments" / FAMILY / task / f"x_{key}"
+    results = directory / "results"
+    summary = results / "summary.json"
+    cached = summary.exists()
+    if not cached:
+        directory.mkdir(parents=True, exist_ok=True)
+        (directory / "candidate_spec.json").write_text(json.dumps({**spec, "candidate": cand}, indent=2))
+        runner_spec = directory / "runner_spec.json"
+        runner_spec.write_text(json.dumps(spec))
+        python = os.environ.get("AIQ_CPPN_PYTHON", sys.executable)
+        assets = Path(os.environ.get("AIQ_CPPN_ASSETS", lab / "cppn_assets"))
+        done = subprocess.run([python, _native(script, python), _native(runner_spec, python),
+                               "--assets", _native(assets, python), "--out", _native(results, python)],
+                              stdin=subprocess.DEVNULL, capture_output=True, text=True)
+        if done.returncode != 0:
+            raise RuntimeError(done.stderr[-600:])
+    data = json.loads(summary.read_text())
+    return {"cached": cached, "mean": data["mean"], "std": data.get("std"), "n_seeds": data.get("n_seeds"),
+            "failed_seeds": [], "excluded": [], "summary": data,
+            "measurement_files": {"candidate_spec.json": _evidence(directory / "candidate_spec.json"),
+                                  "results/summary.json": _evidence(summary)}}
+
+
+def run_lab_job(job: dict, lab: Path) -> dict:
+    """The kb_lab.run_job contract for this family; a failed candidate reports its error, as the other families do."""
+    family, _, task = str(job["dataset"]).partition("/")
+    if family != FAMILY or task not in TASKS:
+        raise ValueError(f"unknown dataset {job['dataset']}")
+    if {"process", "target_transform", "diagnostic_fail_threshold"} & set(job):
+        raise ValueError("unsupported process job control")
+    allowlist = lab / "allowed_datasets.txt"
+    if allowlist.exists() and job["dataset"] not in allowlist.read_text().split():
+        raise ValueError(f"dataset {job['dataset']} is not in the lab (held out or unmeasured)")
+    out = []
+    for cand in job["candidates"]:
+        try:
+            result = run_candidate(task, cand, lab)
+        except (RuntimeError, ValueError) as exc:
+            result = {"cached": False, "mean": None, "measurement_files": {}, "error": f"{type(exc).__name__}: {exc}"[:400]}
+        out.append({**result, "candidate": cand})
+    return {"dataset": job["dataset"], "family": FAMILY, "results": out}
+
+
+def saved_runs(lab: Path) -> list[tuple[str, dict, Path]]:
+    found = []
+    for spec_path in sorted((lab / "experiments" / FAMILY).glob("*/x_*/candidate_spec.json")):
+        spec = json.loads(spec_path.read_text())
+        if (spec_path.parent / "results/summary.json").exists():
+            found.append((spec["task"], spec["candidate"], spec_path.parent / "results"))
+    return found
+
+
+def write_lab(lab: Path) -> None:
+    """lab_db.jsonl rows in the shape load_lab() and experiments expect, one set per task and budget, and the check table."""
+    rows, table = [], []
+    runs = saved_runs(lab)
+    for task, cand, results in runs:
+        data = json.loads((results / "summary.json").read_text())
+        steps = cand["budget"]["training_steps"]
+        size = cand["budget"]["batch_size"]
+        rows.append({"family": FAMILY, "dataset_id": task, "set_id": f"{task}/steps{steps}",
+                     "candidate_id": results.parent.name, "dataset": {"task": task}, "params": None,
+                     "budget": {"training_steps": steps, "batch_size": size, "total_samples_seen": steps * size},
+                     "model_type": cand["model"]["type"], "model": cand["model"], "optimizer": cand["optimizer"],
+                     "loss": cand["loss"], "metric": "forget", "mean": data["mean"], "std": data.get("std"),
+                     "n_seeds": data.get("n_seeds"), "source": "cppn_continual"})
+        table.append((results / "rows.jsonl").read_text())
+    (lab / "lab_db.jsonl").write_text("".join(json.dumps(r) + "\n" for r in rows))
+    (lab / "cppn_continual_db.jsonl").write_text("".join(table))
+    (lab / "allowed_datasets.txt").write_text("\n".join(sorted({f"{FAMILY}/{t}" for t, _, _ in runs})) + "\n")
+
+
+def settle(seed: Path, table: Path) -> dict:
+    """Verdict per seed claim. Read-only: kb-loop keeps no claim status, so the result is reported, not stored."""
+    rows, fingerprint = load_rows([table])
+    report = {"table_sha256": fingerprint, "rows": len(rows), "claims": []}
+    for claim in json.loads(seed.read_text())["claims"]:
+        checks, error = normalize_checks(claim.get("checks"))
+        if error:
+            raise ValueError(f"{claim['id']}: {error}")
+        results = [run_check(check, rows) for check in checks]
+        report["claims"].append({"id": claim["id"], "verdict": verdict(results), "text": claim["text"],
+                                 "checks": [{"state": s, "message": m} for s, m in results]})
+    return report
+
+
+def run_registered(lab: Path) -> None:
+    """Goes through kb_lab.run_job, the entry the run_experiment tool uses. A saved candidate is not rerun."""
+    if __package__:
+        from .kb_lab import run_job
+    else:
+        from kb_lab import run_job
+    failed = False
+    for task in TASKS:
+        job = {"dataset": f"{FAMILY}/{task}", "candidates": [candidate(f) for f in REPLAY_FRACTIONS]}
+        for result in run_job(job, lab_dir=lab)["results"]:
+            label = f"{task} replay {result['candidate']['loss']['replay_fraction']:g}"
+            failed = failed or result["mean"] is None
+            print(label, result.get("error") or json.dumps(result["summary"]), flush=True)
+    if failed:
+        raise SystemExit(1)
+    write_lab(lab)
+
+
+def main() -> None:
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    sub = p.add_subparsers(dest="cmd", required=True)
+    sub.add_parser("run").add_argument("lab_dir")
+    sub.add_parser("lab").add_argument("lab_dir")
+    s = sub.add_parser("settle")
+    s.add_argument("seed")
+    s.add_argument("table")
+    a = p.parse_args()
+    if a.cmd == "run":
+        run_registered(Path(a.lab_dir))
+    elif a.cmd == "lab":
+        write_lab(Path(a.lab_dir))
+    else:
+        print(json.dumps(settle(Path(a.seed), Path(a.table)), ensure_ascii=False, indent=1))
+
+
+if __name__ == "__main__":
+    main()
