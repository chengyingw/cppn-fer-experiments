index 0000000..379d487
--- /dev/null
+++ b/src/aiq_kb/cppn_gpu/continual_seq.py
@@ -0,0 +1,197 @@
+#!/usr/bin/env python3
+"""GPU side of the cppn_continual lab family: fitted dense CPPNs learn a sequence of local edits under a replay budget.
+
+Runs under whichever interpreter has a GPU (AIQ_CPPN_PYTHON), so it imports nothing from aiq_kb. One candidate per call.
+Each network learns the four discs in all four cyclic orders, so every disc comes first once. In each phase the loss is
+the mean error on the current disc plus the mean error on the replay pixels, with fixed weights, so a larger replay budget
+does not shrink the pressure to learn. Replay pixels are drawn once per phase, the same for all networks, from outside the
+current disc; their labels are the true cumulative target, which is the most favourable label source.
+"""
+import argparse
+import glob
+import json
+import os
+import statistics
+import sys
+import time
+
+import numpy as np
+import torch
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from cppn_torch import DenseCPPN, coord_inputs, layerize, load_genome
+
+DEV = 'cuda'
+RES = 64
+FIT_RES = 128
+MAX_FIT_MSE = 0.01
+LR = {'skull': 3e-3, 'butterfly': 3e-3, 'apple': 3e-4}
+DISCS = [(-0.4, -0.4), (0.4, -0.4), (-0.4, 0.4), (0.4, 0.4)]
+RADIUS = 0.2
+MARGIN = 0.05
+ORDERS = [[0, 1, 2, 3], [1, 2, 3, 0], [2, 3, 0, 1], [3, 0, 1, 2]]
+LEARNED = 0.3
+
+
+def picbreeder(assets, task):
+    L = layerize(load_genome(os.path.join(assets, 'genomes', f'{task}.zip')))
+    return DenseCPPN(L['groups'], L['n_hidden']), [torch.tensor(W, dtype=torch.float32, device=DEV)[None] for W in L['weights']]
+
+
+def fitted_dense(assets, task, net_pb, ws_pb):
+    """Dense SGD networks whose image is within MAX_FIT_MSE of the Picbreeder target."""
+    X = coord_inputs(FIT_RES, DEV)
+    with torch.no_grad():
+        target = net_pb.render(ws_pb, X, FIT_RES)[0]
+    net, kept, seeds = None, [], []
+    for path in sorted(glob.glob(os.path.join(assets, 'nets', '*', f'sgd_{task}.pt'))):
+        ck = torch.load(path, weights_only=False)  # our own checkpoints, written by train_sgd.py
+        net = DenseCPPN(ck['groups'], ck['n_hidden'])
+        for k, seed in enumerate(ck['seeds']):
+            ws = [W[k:k + 1].to(DEV) for W in ck['weights']]
+            with torch.no_grad():
+                if ((net.render(ws, X, FIT_RES)[0] - target) ** 2).mean().item() < MAX_FIT_MSE:
+                    kept.append(ws)
+                    seeds.append(seed)
+    return net, [torch.cat([ws[l] for ws in kept]) for l in range(len(net.shapes))], seeds
+
+
+def fit(net, params, X, loss_fn, iters, lr):
+    """Full-batch Adam with per-network unit-norm gradients, captured as one CUDA graph."""
+    opt = torch.optim.Adam(params, lr=lr, capturable=True)
+
+    def step():
+        per = loss_fn(net.render(params, X, RES))
+        per.sum().backward()
+        with torch.no_grad():
+            norm = torch.sqrt(sum(p.grad.pow(2).sum(dim=(1, 2)) for p in params)) + 1e-12
+            for p in params:
+                p.grad /= norm[:, None, None]
+        opt.step()
+        return per.detach()
+
+    warmup = min(3, iters)
+    side = torch.cuda.Stream()
+    side.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(side):
+        for _ in range(warmup):
+            opt.zero_grad(set_to_none=True)
+            step()
+    torch.cuda.current_stream().wait_stream(side)
+    if iters <= warmup:
+        return
+    graph = torch.cuda.CUDAGraph()
+    opt.zero_grad(set_to_none=True)
+    with torch.cuda.graph(graph):
+        step()
+    for _ in range(iters - warmup - 1):
+        graph.replay()
+    del graph
+
+
+def replay_mask(allowed, fraction, seed):
+    if fraction <= 0:
+        return torch.zeros_like(allowed)
+    if fraction >= 1:
+        return allowed.clone()
+    u = torch.rand(allowed.shape, generator=torch.Generator().manual_seed(seed)).to(allowed.device)
+    u[~allowed] = 2.0
+    keep = torch.zeros_like(allowed).reshape(-1)
+    keep[u.reshape(-1).topk(round(fraction * allowed.sum().item()), largest=False).indices] = True
+    return keep.reshape(allowed.shape)
+
+
+def run(spec, assets, out):
+    task, fraction, steps = spec['task'], spec['replay_fraction'], spec['steps']
+    lr = LR[task] * spec['lr_scale']
+    net_pb, ws_pb = picbreeder(assets, task)
+    net, ws, seeds = fitted_dense(assets, task, net_pb, ws_pb)
+    X = coord_inputs(RES, DEV)
+    xx, yy = X[:, 0].reshape(RES, RES), X[:, 1].reshape(RES, RES)
+    dist = [torch.sqrt((xx - cx) ** 2 + (yy - cy) ** 2) - RADIUS for cx, cy in DISCS]
+    discs = [d < 0 for d in dist]
+    never = torch.stack(dist).min(0)[0] > MARGIN
+    with torch.no_grad():
+        old = net_pb.render(ws_pb, X, RES)[0]
+    new = 1 - old
+    size = [((old - new) ** 2).mean(-1)[d].mean().item() for d in discs]
+    E0 = sum(size) / len(size)
+    K, O = len(seeds), len(ORDERS)
+    n = K * O
+    params = [W.repeat_interleave(O, 0).clone().requires_grad_() for W in ws]
+    with torch.no_grad():
+        start = net.render(params, X, RES)
+    R = np.zeros((n, 4, 4))
+    moved_never = np.zeros((n, 4))
+    first_outside = np.zeros(n)
+    t0 = time.time()
+    for phase in range(4):
+        T, Mn, Mr = [], [], []
+        for _ in range(K):
+            for o, order in enumerate(ORDERS):
+                current = order[phase]
+                t = old.clone()
+                for i in order[:phase + 1]:
+                    t[discs[i]] = new[discs[i]]
+                T.append(t)
+                Mn.append(discs[current])
+                Mr.append(replay_mask(~discs[current], fraction, 1009 * (o * 10 + phase) + sum(map(ord, task))))
+        T, Mn, Mr = torch.stack(T), torch.stack(Mn).float(), torch.stack(Mr).float()
+        has_replay = (Mr.sum((1, 2)) > 0).float()
+
+        def loss_fn(img):
+            err = ((img - T) ** 2).mean(-1)
+            return (err * Mn).sum((1, 2)) / Mn.sum((1, 2)) + has_replay * (err * Mr).sum((1, 2)) / Mr.sum((1, 2)).clamp(min=1)
+
+        fit(net, params, X, loss_fn, steps, lr)
+        with torch.no_grad():
+            img = net.render(params, X, RES)
+            change = ((img - start) ** 2).mean(-1)
+            for i, d in enumerate(discs):
+                R[:, phase, i] = (((img - new) ** 2).mean(-1)[:, d].mean(1) / size[i]).cpu().numpy()
+            moved_never[:, phase] = (change[:, never].mean(1) / E0).cpu().numpy()
+            if phase == 0:
+                for j in range(n):
+                    first_outside[j] = (change[j][~discs[ORDERS[j % O][0]]].mean() / E0).item()
+    rows = []
+    for k, seed in enumerate(seeds):
+        for o, order in enumerate(ORDERS):
+            j = k * O + o
+            for pos, disc in enumerate(order):
+                after = float(R[j, pos, disc])
+                final = float(R[j, 3, disc])
+                row = dict(task=task, group=f'replay{fraction:g}', replay_fraction=fraction, lr_scale=spec['lr_scale'],
+                           steps=steps, seed=seed, order=o, disc=disc, position=pos, R_after=round(after, 5),
+                           R_final=round(final, 5), learned=after <= LEARNED, background=round(float(moved_never[j, 3]), 5),
+                           forget=None, forget_best=None, forget_rel=None, first_outside=None)
+                if pos < 3:  # the last edit has nothing after it to forget it
+                    row['forget'] = round(final - after, 5)
+                    row['forget_best'] = round(final - float(R[j, pos:, disc].min()), 5)
+                    if after < 0.999:
+                        row['forget_rel'] = round((final - after) / (1 - after), 5)
+                if pos == 0:
+                    row['first_outside'] = round(float(first_outside[j]), 5)
+                rows.append(row)
+    os.makedirs(out, exist_ok=True)
+    with open(os.path.join(out, 'rows.jsonl'), 'w', encoding='utf-8') as f:
+        f.writelines(json.dumps(r) + '\n' for r in rows)
+    np.savez_compressed(os.path.join(out, 'curves.npz'), R=R, background=moved_never, seeds=np.array(seeds))
+    scored = [r for r in rows if r['forget'] is not None]
+    by_net = [statistics.median(r['forget'] for r in scored if r['seed'] == s) for s in seeds]
+    summary = dict(metric='forget', mean=statistics.median(r['forget'] for r in scored),
+                   std=statistics.pstdev(by_net) if len(by_net) > 1 else 0.0, n_seeds=K, seeds=seeds, n_rows=len(rows),
+                   n_learned=sum(r['learned'] for r in rows), R_after=statistics.median(r['R_after'] for r in rows),
+                   background=statistics.median(r['background'] for r in rows), secs=round(time.time() - t0, 1))
+    with open(os.path.join(out, 'summary.json'), 'w', encoding='utf-8') as f:
+        json.dump(summary, f, indent=1)
+    print(json.dumps(summary))
+
+
+if __name__ == '__main__':
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('spec')
+    p.add_argument('--assets', required=True)
+    p.add_argument('--out', required=True)
+    a = p.parse_args()
+    with open(a.spec, encoding='utf-8') as fh:
+        run(json.load(fh), a.assets, a.out)
diff --git a/src/aiq_kb/cppn_gpu/cppn_torch.py b/src/aiq_kb/cppn_gpu/cppn_torch.py
new file mode 100755
index 0000000..061caec
--- /dev/null
+++ b/src/aiq_kb/cppn_gpu/cppn_torch.py
@@ -0,0 +1,274 @@
+"""Picbreeder genomes -> NEAT graph -> layerized dense CPPN, all in PyTorch.
+
+Re-implements the conventions of the FER paper's code (github.com/akarshkumar0101/fer)
+without loading its pickles or running its code:
+  * inputs x (column axis), y (row axis), d = 1.4*sqrt(x^2+y^2), b = 1; no biases
+  * sigmoid(z) = 2*sigma(z)-1, gaussian(z) = 2*exp(-z^2)-1
+  * rgb = hsv2rgb((h+1) mod 1, clip(s,0,1), clip(|v|,0,1))
+  * layerization: longest-path layers, skip connections carried by identity ("cache") neurons,
+    each layer laid out as activation groups sorted by name.
+"""
+import zipfile
+import xml.etree.ElementTree as ET
+from collections import defaultdict
+
+import numpy as np
+import torch
+
+ACTS = {
+    'cache': lambda z: z,
+    'identity': lambda z: z,
+    'sin': torch.sin,
+    'cos': torch.cos,
+    'tanh': torch.tanh,
+    'sigmoid': lambda z: torch.sigmoid(z) * 2 - 1,
+    'gaussian': lambda z: torch.exp(-z ** 2) * 2 - 1,
+    'relu': torch.relu,
+}
+
+
+# ----------------------------------------------------------------------------- genome parsing
+def load_genome(zip_path):
+    with zipfile.ZipFile(zip_path) as z:
+        names = z.namelist()
+        assert len(names) == 1
+        root = ET.fromstring(z.read(names[0]).decode('utf-8'))
+    genome = root if root.tag == 'genome' else root.find('genome')
+    key = lambda e: f"{e.get('branch')}_{e.get('id')}"
+
+    nodes, links = [], []
+    for n in genome.find('nodes').findall('node'):
+        act = n.find('activation').text.strip()
+        nodes.append(dict(id=key(n.find('marking')), label=n.get('label', ''),
+                          act=act[:-3] if act.endswith('(x)') else act))
+    for l in genome.find('links').findall('link'):
+        links.append(dict(src=key(l.find('source')), dst=key(l.find('target')),
+                          w=float(l.find('weight').text)))
+
+    labels = {n['label']: n['id'] for n in nodes if n['label']}
+    if 'ink' in labels:  # grayscale genome: ink -> brightness, constant-zero hue/saturation
+        labels['brightness'] = labels.pop('ink')
+        for name in ['hue', 'saturation']:
+            nid = f'extra_{name}'
+            nodes.append(dict(id=nid, label=name, act='identity'))
+            links.append(dict(src=labels['brightness'], dst=nid, w=0.0))
+            labels[name] = nid
+    special = dict(x=labels['x'], y=labels['y'], d=labels['d'], b=labels['bias'],
+                   h=labels['hue'], s=labels['saturation'], v=labels['brightness'])
+    return dict(nodes=nodes, links=links, special=special)
+
+
+def coord_inputs(res, device='cpu'):
+    """(res*res, 4) inputs [x, y, d, b]; x varies along columns, y along rows (top = -1)."""
+    xs = torch.linspace(-1, 1, res, device=device)
+    Y, X = torch.meshgrid(xs, xs, indexing='ij')
+    D = torch.sqrt(X ** 2 + Y ** 2) * 1.4
+    return torch.stack([X, Y, D, torch.ones_like(X)], -1).reshape(-1, 4)
+
+
+def hsv2rgb(h, s, v):
+    h = torch.remainder(h + 1, 1.0) * 360.0
+    s, v = s.clamp(0, 1), v.abs().clamp(0, 1)
+    c = v * s
+    x = c * (1 - torch.abs(torch.remainder(h / 60, 2) - 1))
+    m = v - c
+    z = torch.zeros_like(h)
+    sectors = [(c, x, z), (x, c, z), (z, c, x), (z, x, c), (x, z, c), (c, z, x)]
+    r = g = b = 0
+    for k, (r_, g_, b_) in enumerate(sectors):
+        mask = ((h >= 60 * k) & (h < 60 * (k + 1))).to(h.dtype)
+        r, g, b = r + r_ * mask, g + g_ * mask, b + b_ * mask
+    return torch.stack([r + m, g + m, b + m], -1).clamp(0, 1)
+
+
+# ----------------------------------------------------------------------------- NEAT graph evaluation
+def neat_forward(g, res=256):
+    """Reference evaluation directly on the NEAT graph (recursive, like the paper's code)."""
+    act = {n['id']: n['act'] for n in g['nodes']}
+    ins = defaultdict(list)
+    for l in g['links']:
+        ins[l['dst']].append((l['src'], l['w']))
+    sp = g['special']
+    inp = coord_inputs(res).double()
+    val = {sp['x']: inp[:, 0], sp['y']: inp[:, 1], sp['d']: inp[:, 2], sp['b']: inp[:, 3]}
+
+    def get(n):
+        if n not in val:
+            z = torch.zeros(res * res, dtype=torch.float64)
+            for s, w in ins[n]:
+                z = z + w * get(s)
+            val[n] = ACTS[act[n]](z)
+        return val[n]
+
+    h, s, v = get(sp['h']), get(sp['s']), get(sp['v'])
+    return hsv2rgb(h, s, v).reshape(res, res, 3).float(), val
+
+
+# ----------------------------------------------------------------------------- layerization
+def layerize(g):
+    """Port the NEAT graph to a dense MLP computing exactly the same function.
+
+    Returns dict(groups=[(act, count), ...], n_hidden, width, weights=[W_1..W_L, W_out] (numpy),
+    slots=[per hidden layer: {slot: (node_id, novel)}]).
+    """
+    act = {n['id']: n['act'] for n in g['nodes']}
+    sp = g['special']
+    inputs = [sp['x'], sp['y'], sp['d'], sp['b']]
+    outputs = [sp['h'], sp['s'], sp['v']]
+    ins, outs = defaultdict(list), defaultdict(list)
+    for l in g['links']:
+        ins[l['dst']].append((l['src'], l['w']))
+        outs[l['src']].append(l['dst'])
+
+    reach, stack = set(inputs), list(outputs)
+    while stack:
+        n = stack.pop()
+        if n in reach:
+            continue
+        reach.add(n)
+        stack.extend(s for s, _ in ins[n])
+
+    layer = {n: 0 for n in inputs}
+
+    def get_layer(n):
+        if n not in layer:
+            layer[n] = 1 + max((get_layer(s) for s, _ in ins[n]), default=0)
+        return layer[n]
+
+    for n in reach:
+        get_layer(n)
+    n_layers = max(layer.values()) + 1  # including the input layer 0
+
+    contents = [[] for _ in range(n_layers)]
+    for n in sorted(reach, key=lambda n: (layer[n], n)):
+        start = layer[n]
+        if n in outputs:
+            end = n_layers
+        else:
+            targets = [layer[t] for t in outs[n] if t in reach]
+            end = max(targets) if targets else start + 1
+        for i in range(start, end):
+            contents[i].append((n, i == start and n not in inputs))
+    contents[0] = [(n, False) for n in inputs]
+
+    counts = defaultdict(int)
+    for lay in contents:
+        c = defaultdict(int)
+        for n, novel in lay:
+            c[act[n] if novel else 'cache'] += 1
+        for k, v in c.items():
+            counts[k] = max(counts[k], v)
+    groups = order_groups(counts.items())
+    width = sum(v for _, v in groups)
+    offset = dict(zip([k for k, _ in groups], np.cumsum([0] + [v for _, v in groups[:-1]])))
+
+    def positions(lay):
+        pos, used = {}, defaultdict(int)
+        for n, novel in lay:
+            a = act[n] if novel else 'cache'
+            pos[n] = offset[a] + used[a]
+            used[a] += 1
+        return pos
+
+    pos = [None] + [positions(lay) for lay in contents[1:]]
+    pos[0] = {n: i for i, n in enumerate(inputs)}
+
+    weights = []
+    for i in range(1, n_layers):
+        W = np.zeros((4 if i == 1 else width, width))
+        for n, novel in contents[i]:
+            if novel:
+                for s, w in ins[n]:
+                    W[pos[i - 1][s], pos[i][n]] += w
+            else:
+                W[pos[i - 1][n], pos[i][n]] = 1.0
+        weights.append(W)
+    W_out = np.zeros((width, 3))
+    for j, n in enumerate(outputs):
+        W_out[pos[-1][n], j] = 1.0
+    weights.append(W_out)
+
+    slots = [{pos[i][n]: (n, novel) for n, novel in contents[i]} for i in range(1, n_layers)]
+    return dict(groups=groups, n_hidden=n_layers - 1, width=width, weights=weights, slots=slots)
+
+
+LINEAR = ('cache', 'identity')
+
+
+def order_groups(groups):
+    """Linear groups first, then nonlinear ones by name; lets activate() touch only the nonlinear tail.
+    (A permutation of hidden units, so the computed function is unchanged.)"""
+    return sorted(groups, key=lambda g: (g[0] not in LINEAR, g[0]))
+
+
+def arch_string(L):
+    """Same format as the FER repo (groups sorted by name)."""
+    return f"{L['n_hidden']};" + ','.join(f'{a}:{c}' for a, c in sorted(L['groups']))
+
+
+# ----------------------------------------------------------------------------- dense CPPN (batched over parameter sets)
+class DenseCPPN:
+    """Dense CPPN with per-neuron activation groups. Weights are lists of (B, in, out) tensors,
+    so B parameter sets (seeds, perturbations) run in one batched forward pass."""
+
+    def __init__(self, groups, n_hidden):
+        self.groups, self.n_hidden = order_groups(groups), n_hidden
+        self.width = sum(c for _, c in self.groups)
+        self.n_linear = sum(c for a, c in self.groups if a in LINEAR)
+        self.shapes = [(4, self.width)] + [(self.width, self.width)] * (n_hidden - 1) + [(self.width, 3)]
+        self.sizes = [a * b for a, b in self.shapes]
+        self.n_params = sum(self.sizes)
+
+    def activate(self, z):
+        if self.n_linear == self.width:
+            return z
+        parts, i = [z[..., :self.n_linear]], self.n_linear
+        for a, c in self.groups:
+            if a not in LINEAR:
+                parts.append(ACTS[a](z[..., i:i + c]))
+                i += c
+        return torch.cat(parts, -1)
+
+    def forward(self, weights, inputs, return_features=False, chunks=64):
+        """weights: list of (B, in, out); inputs: (N, 4). Returns hsv (B, N, 3) [, features (B, N, w)].
+
+        Pixels are split into `chunks` groups so the backward weight-gradient (a reduction over all
+        pixels into a tiny w x w matrix) runs as many parallel matmuls instead of one starved one."""
+        B, N = weights[0].shape[0], inputs.shape[0]
+        C = chunks if N % chunks == 0 else 1
+        h = inputs.reshape(1, C, N // C, -1).expand(B, -1, -1, -1)
+        feats = [h]
+        for W in weights[:-1]:
+            h = self.activate(torch.matmul(h, W[:, None]))
+            if return_features:
+                feats.append(h)
+        out = torch.matmul(h, weights[-1][:, None]).reshape(B, N, 3)
+        if return_features:
+            return out, [f.reshape(B, N, -1) for f in feats]
+        return out
+
+    def render(self, weights, inputs, res):
+        hsv = self.forward(weights, inputs)
+        return hsv2rgb(hsv[..., 0], hsv[..., 1], hsv[..., 2]).reshape(-1, res, res, 3)
+
+    # flat-vector helpers (one parameter set per row)
+    def unflatten(self, flat):
+        flat = flat if flat.dim() == 2 else flat.unsqueeze(0)
+        out, i = [], 0
+        for (a, b), n in zip(self.shapes, self.sizes):
+            out.append(flat[:, i:i + n].reshape(-1, a, b))
+            i += n
+        return out
+
+    def flatten(self, weights):
+        return torch.cat([W.reshape(W.shape[0], -1) for W in weights], 1)
+
+    def lecun_init(self, n_sets, generator, device='cpu'):
+        """Truncated-normal LeCun init (matches flax's default nn.Dense kernel init)."""
+        ws = []
+        for a, b in self.shapes:
+            std = (1.0 / a) ** 0.5 / 0.87962566103423978
+            w = torch.empty(n_sets, a, b)
+            torch.nn.init.trunc_normal_(w, std=std, a=-2 * std, b=2 * std, generator=generator)
+            ws.append(w.to(device))
+        return ws
