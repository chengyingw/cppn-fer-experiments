+"""The cppn_continual lab family: a fake runner stands in for the GPU process, so these run anywhere."""
+import json
+import os
+from pathlib import Path
+import sys
+import tempfile
+import threading
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+from aiq_kb import kb_cppn, kb_lab, kb_science_loop as loop
+from aiq_kb.kb_checks import BAND, FAIL, NODATA, PASS, normalize_checks, run_check
+
+FAKE_RUNNER = """
+import argparse, json, os
+p = argparse.ArgumentParser(); p.add_argument('spec'); p.add_argument('--assets'); p.add_argument('--out')
+a = p.parse_args()
+spec = json.load(open(a.spec))
+os.makedirs(a.out, exist_ok=True)
+f = spec['replay_fraction']
+if f == 0.77:
+    raise SystemExit('runner failure')
+open(os.path.join(a.out, 'rows.jsonl'), 'w').write(json.dumps({'task': spec['task'], 'group': f'replay{f:g}', 'forget': 0.6 - f}) + '\\n')
+json.dump({'metric': 'forget', 'mean': 0.6 - f, 'std': 0.01, 'n_seeds': 3}, open(os.path.join(a.out, 'summary.json'), 'w'))
+"""
+
+
+def rows(group, *values):
+    return [{"task": "t", "group": group, "m": v} for v in values]
+
+
+class CheckTypes(unittest.TestCase):
+    def test_difference_bands_and_missing_data(self):
+        raw = {"type": "difference", "metric": "m", "where": {"task": "t"}, "group_a": "a", "group_b": "b",
+               "pass": {"op": ">=", "value": 0.2}, "fail": {"op": "<=", "value": 0.05}}
+        check = normalize_checks([raw])[0][0]
+        for value, want in [(0.5, PASS), (0.1, BAND), (0.0, FAIL)]:
+            self.assertEqual(run_check(check, rows("a", value, value) + rows("b", 0.0, 0.0))[0], want)
+        self.assertEqual(run_check(check, rows("a", 0.5))[0], NODATA)
+
+    def test_median_bands_and_missing_data(self):
+        raw = {"type": "median", "metric": "m", "where": {"task": "t"}, "group": "a",
+               "pass": {"op": ">=", "value": 0.3}, "fail": {"op": "<=", "value": 0.05}}
+        check = normalize_checks([raw])[0][0]
+        for value, want in [(0.4, PASS), (0.2, BAND), (0.01, FAIL)]:
+            self.assertEqual(run_check(check, rows("a", value, value))[0], want)
+        self.assertEqual(run_check(check, rows("a", 0.4))[0], NODATA)
+
+    def test_table_only_and_validated(self):
+        base = {"type": "median", "metric": "m", "where": {}, "group": "a", "pass": {"op": ">=", "value": 1},
+                "fail": {"op": "<=", "value": 0}}
+        self.assertIsNone(normalize_checks([base])[1])
+        self.assertIsNotNone(normalize_checks([{**base, "source": "lab"}])[1])
+        self.assertIsNotNone(normalize_checks([{k: v for k, v in base.items() if k != "group"}])[1])
+        same = {"type": "difference", "metric": "m", "where": {}, "group_a": "a", "group_b": "a",
+                "pass": {"op": ">=", "value": 1}, "fail": {"op": "<=", "value": 0}}
+        self.assertIsNotNone(normalize_checks([same])[1])
+
+
+class Lab(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self.dir.cleanup)
+        self.lab = Path(self.dir.name) / "lab"
+        self.lab.mkdir()
+        runner = Path(self.dir.name) / "fake_runner.py"
+        runner.write_text(FAKE_RUNNER)
+        env = patch.dict(os.environ, {"AIQ_CPPN_PYTHON": sys.executable, "AIQ_CPPN_RUNNER": str(runner),
+                                      "AIQ_CPPN_ASSETS": str(self.lab)})
+        env.start()
+        self.addCleanup(env.stop)
+
+    def job(self, *fractions, task="skull"):
+        return {"dataset": f"{kb_cppn.FAMILY}/{task}", "candidates": [kb_cppn.candidate(f) for f in fractions]}
+
+    def test_run_job_dispatches_family_and_caches(self):
+        first = kb_lab.run_job(self.job(0.0, 0.2), lab_dir=self.lab)
+        self.assertEqual(first["family"], kb_cppn.FAMILY)
+        self.assertEqual([round(r["mean"], 3) for r in first["results"]], [0.6, 0.4])
+        self.assertEqual({r["candidate"]["loss"]["replay_fraction"] for r in first["results"]}, {0.0, 0.2})
+        self.assertFalse(first["results"][0]["cached"])
+        self.assertTrue(kb_lab.run_job(self.job(0.0), lab_dir=self.lab)["results"][0]["cached"])
+
+    def test_failed_and_invalid_candidates_report_errors_without_a_mean(self):
+        bad = kb_cppn.candidate(0.0)
+        bad["loss"]["replay_fraction"] = 2
+        job = self.job(0.77)
+        job["candidates"].append(bad)
+        results = kb_lab.run_job(job, lab_dir=self.lab)["results"]
+        self.assertTrue(all(r["mean"] is None and r["error"] for r in results))
+
+    def test_unknown_task_and_allowlist_are_refused(self):
+        with self.assertRaises(ValueError):
+            kb_lab.run_job(self.job(0.0, task="nope"), lab_dir=self.lab)
+        (self.lab / "allowed_datasets.txt").write_text(f"{kb_cppn.FAMILY}/apple\n")
+        with self.assertRaises(ValueError):
+            kb_lab.run_job(self.job(0.0), lab_dir=self.lab)
+
+    def test_lab_rows_and_table_from_saved_results(self):
+        kb_lab.run_job(self.job(0.0, 0.2), lab_dir=self.lab)
+        kb_cppn.write_lab(self.lab)
+        lab_rows = [json.loads(x) for x in (self.lab / "lab_db.jsonl").read_text().splitlines()]
+        self.assertEqual(len(lab_rows), 2)
+        self.assertEqual({r["set_id"] for r in lab_rows}, {"skull/steps500"})
+        self.assertEqual(lab_rows[0]["metric"], "forget")
+        self.assertEqual(len((self.lab / "cppn_continual_db.jsonl").read_text().splitlines()), 2)
+        self.assertIn(f"{kb_cppn.FAMILY}/skull", (self.lab / "allowed_datasets.txt").read_text())
+
+    def test_run_experiment_tool_varies_replay_through_the_real_lab_cli(self):
+        kb_lab.run_job(self.job(0.0), lab_dir=self.lab)
+        kb_cppn.write_lab(self.lab)
+        base = json.loads((self.lab / "lab_db.jsonl").read_text().splitlines()[0])
+        run = Path(self.dir.name) / "runs" / "r"
+        (run / "lab_jobs").mkdir(parents=True)
+        host = SimpleNamespace(lab_row=lambda ref: base, worker_job=None, run=run, lab_sem=threading.Semaphore(1),
+                               lock=threading.Lock(), cur_epoch=1, lab_dataset_params=lambda ds: {},
+                               args=SimpleNamespace(research_max_cands=4, lab=str(self.lab / "lab_db.jsonl"), lab_workers=1,
+                                                    pool=str(self.lab / "absent.jsonl")))
+        reply = json.loads(loop.Loop.experiment(host, {"base": "b", "variants": [{"loss.replay_fraction": 0.05},
+                                                                                {"loss.replay_fraction": 0.2}]}, []))
+        self.assertEqual(reply["metric"], "forget")
+        self.assertEqual([round(r["mean"], 3) for r in reply["results"]], [0.55, 0.4])
+        added = [json.loads(x) for x in (run / "lab_experiments.jsonl").read_text().splitlines()]
+        self.assertEqual([r["loss"]["replay_fraction"] for r in added], [0.05, 0.2])
+
+
+class Seed(unittest.TestCase):
+    def test_registered_claims_load_as_a_kb_seed_and_settle_without_data(self):
+        seed = Path(__file__).resolve().parents[1] / "research/cppn_continual_20261101/seed_kb.json"
+        with tempfile.TemporaryDirectory() as d:
+            kb = loop.KB.seed(Path(d), seed)
+            self.assertTrue(kb.claims)
+            self.assertTrue(all(c.get("checks") for c in kb.claims.values()))
+            report = kb_cppn.settle(seed, Path(d) / "absent.jsonl")
+        self.assertTrue(report["claims"])
+        self.assertEqual({c["verdict"] for c in report["claims"]}, {"INCONCLUSIVE"})
+
+
+if __name__ == "__main__":
+    unittest.main()
