+"""Writes seed_kb.json: the claims for the sequence test, frozen by a commit made before any run."""
+import json
+from pathlib import Path
+
+SCOPE = ('Regime: fitted dense CPPNs on skull, butterfly and apple at 64x64; four non-overlapping discs of colour inversion '
+         'learned in sequence, 500 steps each, in four cyclic orders; Adam reset each phase at the training learning rate; '
+         'loss is mean error on the current disc plus mean error on replay pixels, with fixed weights; replay pixels drawn '
+         'once per phase, labelled by the true cumulative target. Rows share networks, so medians describe these networks. '
+         'Forgetting is R_final - R_after over all earlier discs, unfiltered; the learned subset is a sensitivity analysis. ')
+TWO = ['skull', 'butterfly']
+
+
+def band(kind, label, metric, task, ok, bad, **fields):
+    return {'type': kind, 'label': label, 'metric': metric, 'where': {'task': task}, **fields,
+            'pass': dict(zip(('op', 'value'), ok)), 'fail': dict(zip(('op', 'value'), bad))}
+
+
+claims = [
+    dict(id='K9001',
+         text=SCOPE + 'Claim: with no replay, a later edit erases much of an earlier one on skull and butterfly: median '
+                      'forget >= 0.3; <= 0.05 falsifies; between is mixed.',
+         checks=[band('median', f'no_replay_forgets_{t}', 'forget', t, ('>=', 0.3), ('<=', 0.05), group='replay0', min_n=10)
+                 for t in TWO]),
+    dict(id='K9002',
+         text=SCOPE + 'Claim: forgetting depends on replay on skull and butterfly: median forget at no replay minus at full '
+                      'replay >= 0.2; <= 0.05 falsifies; between is mixed.',
+         checks=[band('difference', f'replay_dependence_{t}', 'forget', t, ('>=', 0.2), ('<=', 0.05),
+                      group_a='replay0', group_b='replay1', min_n=10) for t in TWO]),
+    dict(id='K9003',
+         text=SCOPE + 'Claim: 5% replay is enough for a large reduction on skull and butterfly: median forget at 5% is at most '
+                      'half of no replay; >= 0.9 of it falsifies; between is mixed.',
+         checks=[band('ratio', f'five_percent_{t}', 'forget', t, ('<=', 0.5), ('>=', 0.9),
+                      group_a='replay0.05', group_b='replay0', min_n=10) for t in TWO]),
+    dict(id='K9004',
+         text=SCOPE + 'Claim: local edits stay hard on apple within this budget even with full replay: median R_after >= 0.1; '
+                      '<= 0.05 falsifies; between is mixed. Earlier edits were at other positions, so this may not carry over.',
+         checks=[band('median', 'apple_hard', 'R_after', 'apple', ('>=', 0.1), ('<=', 0.05), group='replay1', min_n=10)]),
+]
+for c in claims:
+    c.update(support_count=0, failure_count=0, origin='preregistered:cppn_continual_20261101')
+Path(__file__).with_name('seed_kb.json').write_text(json.dumps({'claims': claims}, indent=1))
