+"""Executable claim checks: replay on synthetic lab rows, the write gates, and real tool calls from fake CLIs."""
+import copy
+import json
+import os
+from pathlib import Path
+import sys
+import tempfile
+import threading
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+from aiq_kb import kb_science_loop as loop, cc_agent, codex_agent, sample_kb_science_release as release
+from aiq_kb.kb_checks import BAND, FAIL, MIN_PAIRS, MIN_SETS, NODATA, PASS, normalize_checks, run_check, verdict
+
+
+def row(set_id, optimizer, mean, family="wins", **extra):
+    return {"family": family, "set_id": set_id, "candidate_id": f"c_{optimizer}_{mean}", "metric": "loss", "depth": 2,
+            "width": 64, "optimizer": {"type": optimizer}, "mean": mean, "std": .01, **extra}
+
+
+def lab_rows():
+    """Adam wins six sets in family `wins`, loses six in `loses`; family `thin` has too few sets to conclude anything."""
+    rows = []
+    for i in range(6):
+        rows += [row(f"w{i}", "Adam", 1.0), row(f"w{i}", "SGD", 2.0)]
+        rows += [row(f"l{i}", "Adam", 2.0, "loses"), row(f"l{i}", "SGD", 1.0, "loses")]
+    return rows + [row("t0", "Adam", 1.0, "thin"), row("t0", "SGD", 2.0, "thin")]
+
+
+def check(family="wins", kind="win_rate", op=">=", value=.7, **extra):
+    return {"type": kind, "where": {"family": family}, "a": {"optimizer.type": "Adam"},
+            "b": {"optimizer.type": "SGD"}, "op": op, "value": value, **extra}
+
+
+def normal(*checks):
+    out, error = normalize_checks(list(checks))
+    assert error is None, error
+    return out
+
+
+def claim(cid="K1001", text="Measured local observation", s=3., f=1., **extra):
+    return {"id": cid, "text": text, "support_count": s, "failure_count": f, "credibility": (s + 1) / (s + f + 2),
+            "created_epoch": 0, "sources": [], "merged_from": [], **extra}
+
+
+class ReplayTests(unittest.TestCase):
+    def state(self, c, rows):
+        return run_check(normal(c)[0], rows)[0]
+
+    def test_win_rate_passes_and_fails_on_the_measured_direction(self):
+        self.assertEqual(self.state(check("wins"), lab_rows()), PASS)
+        self.assertEqual(self.state(check("loses"), lab_rows()), FAIL)
+
+    def test_loss_ratio_is_the_median_of_a_over_b(self):
+        self.assertEqual(self.state(check("wins", "loss_ratio", "<=", .6), lab_rows()), PASS)
+        self.assertEqual(self.state(check("wins", "loss_ratio", "<=", .4), lab_rows()), FAIL)
+
+    def test_loss_ratio_ignores_pairs_where_a_ratio_of_losses_has_no_meaning(self):
