-HARNESS_VERSION = hashlib.sha1((KB_BLOCK + DISCOVER_PROMPT + GUIDE_RIGHT + GUIDE_WRONG + SUMMARIZER_SYSTEM)
+CHECKS_RULE = """
+Executable checks: add, revise and merge accept `checks`, replayed by the harness on stored data whenever a claim is
+written. On load_lab(), compare two arms inside one set_id, e.g. {"type": "win_rate", "where": {"family": "f"},
+"a": {"optimizer.type": "Adam"}, "b": {"optimizer.type": "SGD"}, "pair_on": ["depth", "width"], "op": ">=", "value": 0.7,
+"min_pairs": 8, "min_sets": 4}. type win_rate is the share of pairs a wins on lower loss; type loss_ratio is the median of
+a/b, so {"op": "<=", "value": 0.9} means at least 10% lower loss. Use pair_on to hold confounders equal. min_pairs is at
+least 5 and min_sets at least 3. Merged and revised claims inherit every ancestor check and are written only if all of
+them pass, so a claim that no longer passes must be deleted and restated. A failing check rejects an added claim; too
+little data does not, and the claim stays pending. Too little data is never a falsification."""
+CHECK_TABLE_RULE = """
+Checks can also read this run's result tables, one row per run. {"type": "ratio", "metric": "F", "where": {"task": "t"},
+"group_a": "A", "group_b": "B", "min_n": 3, "pass": {"op": "<=", "value": 0.5}, "fail": {"op": ">=", "value": 1.0}} is
+median A / median B. position takes metric, where, low_group, high_group, test_group, pass and fail, and places the test
+group at r=0 for the low group and r=1 for the high group, over rows with fit=true. count takes where, where_total,
+min_total, op and value, and counts rows once where_total selects at least min_total. A result between pass and fail is
+MIXED: an added claim stays pending, merge and revise are refused, and it is not a falsification."""
+
+HARNESS_VERSION = hashlib.sha1((KB_BLOCK + DISCOVER_PROMPT + GUIDE_RIGHT + GUIDE_WRONG + SUMMARIZER_SYSTEM + CHECKS_RULE
+                                + CHECK_TABLE_RULE)
                                .encode()).hexdigest()[:10]
 SCIENCE_HARNESS = hashlib.sha1((HARNESS_VERSION + KB_TOOL_NOTE_SCIENCE + SCIENCE_RULE + RESEARCH_SYSTEM + CONTROL_RULE)
                                .encode()).hexdigest()[:10]
