+++ b/src/aiq_kb/kb_checks.py
@@ -0,0 +1,290 @@
+"""Executable claim checks, replayed on stored measurements. Too little data is NODATA, never a falsification.
+
+Two sources, chosen by a check's `source`:
+
+lab (--lab plus this run's experiments; the default for win_rate and loss_ratio). Compares arms a and b by each row's
+`mean` (10-seed mean of the selection metric; lower is better), and a comparison never leaves one set_id:
+
+  {"type": "win_rate", "where": {"family": "f"}, "a": {"optimizer.type": "Adam"}, "b": {"optimizer.type": "SGD"},
+   "pair_on": ["depth", "width"], "op": ">=", "value": 0.7, "min_pairs": 8, "min_sets": 4}
+
+One pair is one set_id + pair_on cell holding both arms, with each arm averaged inside the cell. win_rate is the share
+of pairs a wins (ties count one half); loss_ratio is the median of a/b, so loss_ratio <= 0.9 reads "a has at least 10%
+lower loss". Rows that failed seeds or were excluded are not measurements.
+
+table (--check-table, repeatable and concatenated; the default for count, position and ratio). One row per run, selected
+by `where`, with the meaning kb/verify_kb.py gives these types in the CPPN/FER project:
+
+  {"type": "ratio", "metric": "F", "where": {"task": "t"}, "group_a": "A", "group_b": "B", "min_n": 3,
+   "pass": {"op": "<=", "value": 0.5}, "fail": {"op": ">=", "value": 1.0}}
+
+ratio is median A / median B. position is (median test - median low) / (median high - median low) over fitted rows.
+count compares a row count to `value` once `where_total` selects at least `min_total` rows. Between pass and fail is BAND.
+position and ratio cannot read the lab, because their groups are not held inside one set_id.
+
+Keys are dotted paths into a row. A list value means any of, or that exact list when the field is itself a list.
+"""
+from __future__ import annotations
+
+import collections
+import functools
+import hashlib
+import json
+import math
+import operator
+import statistics
+from pathlib import Path
+
+OPS = {">=": operator.ge, "<=": operator.le, ">": operator.gt, "<": operator.lt}
+PASS, FAIL, BAND, NODATA = "PASS", "FAIL", "BAND", "NODATA"
+MIN_PAIRS, MIN_SETS = 5, 3
+_PAIRED = ({"a", "b", "op", "value"}, {"where", "pair_on", "min_pairs", "min_sets"}, ("lab", "table"))
+FIELDS = {  # required fields, optional fields, allowed sources (the first is the default)
+    "win_rate": _PAIRED,
+    "loss_ratio": _PAIRED,
+    "count": ({"where", "where_total", "min_total", "op", "value"}, set(), ("table", "lab")),
+    "position": ({"metric", "where", "low_group", "high_group", "test_group", "pass", "fail"}, {"test_where", "min_n"},
+                 ("table",)),
+    "ratio": ({"metric", "where", "group_a", "group_b", "pass", "fail"}, {"min_n"}, ("table",)),
+}
+COMMON = {"type", "check_id", "label", "source"}
+
+
+def _is_count(x) -> bool:
+    return isinstance(x, int) and not isinstance(x, bool)
+
+
+def _is_number(x) -> bool:
+    return isinstance(x, (int, float)) and not isinstance(x, bool) and math.isfinite(x)
+
+
+def _selector(x) -> bool:
+    return isinstance(x, dict) and all(isinstance(k, str) and k for k in x)
+
+
+def _threshold(x) -> bool:
+    return isinstance(x, dict) and set(x) == {"op", "value"} and x["op"] in OPS and _is_number(x["value"])
+
+
+def _invalid_band(c: dict) -> str | None:
+    good, bad = c["pass"], c["fail"]
+    if not (_threshold(good) and _threshold(bad)):
+        return f"check pass and fail must each be {{op, value}} with op in {list(OPS)}"
+    if good["op"][0] == bad["op"][0] or (good["value"] > bad["value"] if good["op"][0] == "<" else good["value"] < bad["value"]):
+        return "check pass and fail must point away from each other, so both can be reached"
+    return None
+
+
+def _invalid(c) -> str | None:
+    if not isinstance(c, dict) or c.get("type") not in FIELDS:
+        return f"check type must be one of {list(FIELDS)}"
+    kind, (required, optional, sources) = c["type"], FIELDS[c["type"]]
+    if set(c) - required - optional - COMMON:
+        return f"{kind} check has unknown fields {sorted(set(c) - required - optional - COMMON)}"
+    if required - set(c):
+        return f"{kind} check is missing fields {sorted(required - set(c))}"
+    if any(key in c and not (isinstance(c[key], str) and c[key]) for key in ("check_id", "label")):
+        return "check check_id and label must be nonempty strings"
+    if c.get("source", sources[0]) not in sources:
+        return f"{kind} check source must be one of {list(sources)}"
+    for key in ("where", "where_total", "test_where"):
+        if key in c and not _selector(c[key]):
+            return f"check {key} must be an object"
+    if kind in ("win_rate", "loss_ratio"):
+        return _invalid_paired(c)
+    if kind == "count":
+        if not _is_count(c["min_total"]) or c["min_total"] < 1:
+            return "check min_total must be an integer of at least 1"
+        return _invalid_compare(c)
+    names = ("low_group", "high_group", "test_group") if kind == "position" else ("group_a", "group_b")
+    if any(not (isinstance(c[key], str) and c[key]) for key in (*names, "metric")):
+        return f"check {' and '.join(names)} and metric must be nonempty strings"
+    if c[names[0]] == c[names[1]]:
+        return f"check {names[0]} and {names[1]} must differ"
+    if "min_n" in c and (not _is_count(c["min_n"]) or c["min_n"] < 1):
+        return "check min_n must be an integer of at least 1"
+    return _invalid_band(c)
+
+
+def _invalid_compare(c: dict) -> str | None:
+    if c["op"] not in OPS:
+        return f"check op must be one of {list(OPS)}"
+    if not _is_number(c["value"]):
+        return "check value must be a finite number"
+    return None
+
+
+def _invalid_paired(c: dict) -> str | None:
+    a, b = c["a"], c["b"]
+    if not (_selector(a) and _selector(b) and any(k in b and a[k] != b[k] for k in a)):
+        return "check arms a and b must share a key with different values, so no row falls in both"
+    pair_on = c.get("pair_on", [])
+    if not isinstance(pair_on, list) or any(not isinstance(k, str) or not k for k in pair_on):
+        return "check pair_on must be a list of field names"
+    if set(pair_on) & (set(a) | set(b)):
+        return "check pair_on cannot hold a field that defines an arm"
+    error = _invalid_compare(c)
+    if error:
+        return error
+    if c["type"] == "win_rate" and not 0 < c["value"] < 1:
+        return "win_rate value must lie strictly between 0 and 1"
+    if c["type"] == "loss_ratio" and c["value"] <= 0:
+        return "loss_ratio value must be positive"
+    for key, floor in (("min_pairs", MIN_PAIRS), ("min_sets", MIN_SETS)):
+        if not _is_count(c.get(key, floor)) or c.get(key, floor) < floor:
+            return f"check {key} must be an integer of at least {floor}"
+    return None
+
+
+def normalize_checks(raw) -> tuple[list[dict], str | None]:
+    """Validate submitted checks. IDs are content hashes, so nobody can replace an ancestor's check by reusing its name;
+    a submitted check_id survives only as a label, to trace the check back to where it was registered."""
+    if raw is None:
+        return [], None
+    if not isinstance(raw, list):
+        return [], "checks must be a list of objects"
+    out = []
+    for c in raw:
+        error = _invalid(c)
+        if error:
+            return [], error
+        body = {k: v for k, v in c.items() if k not in ("check_id", "label")}
+        body.setdefault("source", FIELDS[c["type"]][2][0])
+        if c["type"] in ("win_rate", "loss_ratio"):
+            body.update(where=c.get("where", {}), pair_on=sorted(set(c.get("pair_on", []))),
+                        min_pairs=c.get("min_pairs", MIN_PAIRS), min_sets=c.get("min_sets", MIN_SETS))
+        elif c["type"] in ("position", "ratio"):
+            body.setdefault("min_n", 2)
+        cid = "C" + hashlib.sha256(json.dumps(body, sort_keys=True).encode()).hexdigest()[:10]
+        label = c.get("label") or c.get("check_id")
+        out.append({"check_id": cid, **({"label": label} if label and label != cid else {}), **body})
+    return merge_checks(out), None
+
+
+def merge_checks(*groups: list[dict]) -> list[dict]:
+    """Union by content. The first occurrence keeps its label, so a descendant cannot rename an ancestor's check."""
+    out = {}
+    for group in groups:
+        for c in group:
+            out.setdefault(c["check_id"], c)
+    return list(out.values())
+
+
+def check_name(check: dict) -> str:
+    return check.get("label") or check["check_id"]
+
+
+def lookup(row: dict, key: str):
+    value = row
+    for part in key.split("."):
+        value = value.get(part) if isinstance(value, dict) else None
+    return value
+
+
+def matches(row: dict, where: dict) -> bool:
+    for key, wanted in where.items():
+        value = lookup(row, key)
+        if value != wanted and not (isinstance(wanted, list) and value in wanted):
+            return False
+    return True
+
+
+def _measured(row: dict) -> bool:
+    return (bool(row.get("set_id")) and _is_number(row.get("mean"))
+            and not row.get("excluded") and not row.get("failed_seeds"))
+
+
+def pairs(check: dict, rows: list[dict]) -> list[tuple[float, float, str]]:
+    """(a mean, b mean, set_id) for every set_id + pair_on cell where both arms were measured on one metric."""
+    cells = collections.defaultdict(lambda: ([], []))
+    for row in rows:
+        if not _measured(row) or not matches(row, check["where"]):
+            continue
+        cell = [lookup(row, k) for k in check["pair_on"]]
+        if None in cell:
+            continue
+        for side, arm in enumerate((check["a"], check["b"])):
+            if matches(row, arm):
+                cells[row["set_id"], json.dumps(cell, sort_keys=True)][side].append(row)
+    out = []
+    for (set_id, _), (left, right) in sorted(cells.items()):
+        if left and right and len({r.get("metric") for r in left + right}) == 1:
+            out.append((statistics.fmean(r["mean"] for r in left), statistics.fmean(r["mean"] for r in right), set_id))
+    return out
+
+
+def _group_median(rows: list[dict], where: dict, metric: str, min_n: int = 1) -> float | None:
+    values = [lookup(r, metric) for r in rows if matches(r, where)]
+    values = [v for v in values if _is_number(v)]
+    return statistics.median(values) if len(values) >= min_n else None
+
+
+def _banded(stat: float, check: dict, message: str) -> tuple[str, str]:
+    if OPS[check["pass"]["op"]](stat, check["pass"]["value"]):
+        return PASS, message
+    if OPS[check["fail"]["op"]](stat, check["fail"]["value"]):
+        return FAIL, message
+    return BAND, message
+
+
+def run_check(check: dict, rows: list[dict]) -> tuple[str, str]:
+    """Returns (PASS | FAIL | BAND | NODATA, message). rows must come from the check's source."""
+    name, kind = check_name(check), check["type"]
+    if kind == "count":
+        if sum(matches(r, check["where_total"]) for r in rows) < check["min_total"]:
+            return NODATA, f"{name}: fewer than {check['min_total']} runs"
+        n = sum(matches(r, check["where"]) for r in rows)
+        ok = OPS[check["op"]](n, check["value"])
+        return (PASS if ok else FAIL), f"{name}: count={n}, need {check['op']} {check['value']}"
+    if kind == "position":  # r = 0 means the test group sits at the low group's value, r = 1 at the high group's
+        where, metric = {**check["where"], "fit": True}, check["metric"]
+        low = _group_median(rows, {**where, "group": check["low_group"]}, metric)
+        high = _group_median(rows, {**where, "group": check["high_group"]}, metric)
+        test = _group_median(rows, {**where, "group": check["test_group"], **check.get("test_where", {})}, metric, check["min_n"])
+        if low is None or high is None or test is None:
+            return NODATA, f"{name}: not enough fitted runs for {check['test_group']} (low={low}, high={high}, test={test})"
+        if abs(high - low) < 1e-9:
+            return NODATA, f"{name}: reference groups coincide"
+        r = (test - low) / (high - low)
+        return _banded(r, check, f"{name}: r={r:.3f} ({check['low_group']}={low:.3f}, {check['test_group']}={test:.3f}, "
+                                 f"{check['high_group']}={high:.3f})")
+    if kind == "ratio":
+        a = _group_median(rows, {**check["where"], "group": check["group_a"]}, check["metric"], check["min_n"])
+        b = _group_median(rows, {**check["where"], "group": check["group_b"]}, check["metric"], check["min_n"])
+        if a is None or b is None or b <= 0:
+            return NODATA, f"{name}: not enough data ({check['group_a']}={a}, {check['group_b']}={b})"
+        return _banded(a / b, check, f"{name}: ratio={a / b:.3f} ({check['group_a']}={a:.4g}, {check['group_b']}={b:.4g})")
+    found = pairs(check, rows)
+    if kind == "loss_ratio":  # a ratio of losses only means something when both are nonnegative and b is not zero
+        found = [p for p in found if p[0] >= 0 and p[1] > 0]
+    sets = len({p[2] for p in found})
+    if len(found) < check["min_pairs"] or sets < check["min_sets"]:
+        return NODATA, (f"{name}: {len(found)} pairs in {sets} sets, "
+                        f"need at least {check['min_pairs']} in {check['min_sets']}")
+    if kind == "win_rate":
+        stat = sum(1.0 if a < b else 0.5 if a == b else 0.0 for a, b, _ in found) / len(found)
+    else:
+        stat = statistics.median(a / b for a, b, _ in found)
+    ok = OPS[check["op"]](stat, check["value"])
+    return (PASS if ok else FAIL), (f"{name}: {kind}={stat:.3f} over {len(found)} pairs in {sets} sets, "
+                                    f"need {check['op']} {check['value']}")
+
+
+def verdict(results: list[tuple[str, str]]) -> str:
+    states = [state for state, _ in results]
+    if FAIL in states:
+        return "FALSIFIED"
+    if NODATA in states:
+        return "INCONCLUSIVE"
+    return "MIXED" if BAND in states else "VERIFIED"
+
+
+@functools.lru_cache(maxsize=2)
+def _parse(data: bytes) -> list[dict]:
+    return [json.loads(x) for x in data.decode("utf-8").splitlines() if x.strip()]
+
+
+def load_rows(paths: list[Path]) -> tuple[list[dict], str]:
+    """Rows of these JSONL files, with a fingerprint of their bytes. A file not written yet holds no rows; a torn line raises."""
+    data = b"\n".join(path.read_bytes() for path in paths if path.exists())
+    return _parse(data), hashlib.sha256(data).hexdigest()[:12]
